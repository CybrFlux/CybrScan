# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CybrScan — observation source for the passive engine (Workstream 1 <-> Security).
# The engine itself is Security's real passive engine; only the observation
# source swaps. "mock" injects deterministic observations; switch to the
# SSRF-hardened fetch layer (§6, CTO/AppSec) when it lands.
SCAN_OBSERVATIONS=mock

# Stripe (Workstream 1 billing + CRO price config). Price IDs come from the
# Stripe dashboard (test mode first). Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Optional: error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
